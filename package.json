{
  "name": "adamsecada",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "playwright test",
    "test:links": "start-server-and-test \"vite preview --host 127.0.0.1 --port 4174 --strictPort --base /crackedbuilders/\" http://127.0.0.1:4174/crackedbuilders/ \"linkinator http://127.0.0.1:4174/crackedbuilders/ --recurse --check-css --check-fragments --skip ^https://amsecada.github.io/crackedbuilders/$\"",
    "verify": "npm run check && npm run build && npm run test:links && npm test"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.6",
    "astro": "^7.2.9"
