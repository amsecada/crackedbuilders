---
import SectionHeading from './SectionHeading.astro';
import { contactLinks } from '../data/site';
---

<section id="contact" class="section section--contact page-shell" aria-labelledby="contact-title">
  <SectionHeading number="04" title="Contact" id="contact-title" />
  <p class="contact-callout">Building something <em>interesting?</em></p>
  <p class="contact-response">Ping me<span aria-hidden="true">.</span></p>
  <div class="contact-footer">
    <p>Interesting project, weird idea, or something I should know about?</p>
    <ul class="social-links" aria-label="Social links">
      {contactLinks.map((link, index) => (
        <li>
          {link.placeholder ? (
            <span class="social-link social-link--offline" aria-label={`${link.label}: ${link.handle}`}>
              <span class="social-link__index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <span class="social-link__platform">{link.label}</span>
              <span class="social-link__handle">{link.handle}</span>
              <span class="social-link__status" aria-hidden="true">[--]</span>
            </span>
          ) : (
            <a class="social-link" href={link.url} target="_blank" rel="noopener noreferrer">
              <span class="social-link__index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <span class="social-link__platform">{link.label}</span>
              <span class="social-link__handle">{link.handle}</span>
              <span class="social-link__status" aria-hidden="true">[↗]</span>
            </a>
          )}
        </li>
      ))}
    </ul>
  </div>
  <i class="contact-slash" aria-hidden="true"></i>
</section>
