---
interface Props {
  number: string;
  title: string;
  id: string;
}

const { number, title, id } = Astro.props;
---

<div class="section-heading">
  <span class="section-heading__number" aria-hidden="true">{number}</span>
  <h2 id={id}>{title}</h2>
  <span class="section-heading__rule" aria-hidden="true"></span>
</div>
